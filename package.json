{
  "name": "vex-bot",
  "version": "1.3.1",
  "private": true,
  "description": "Bot de Discord para la comunidad de THE FINALS",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env scripts/start.js",
    "start:test": "node --env-file=.env scripts/start.js --test",
    "dev": "node --env-file=.env --watch src/index.js",
    "test": "node --test",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "playwright": "1.64.0",
    "sharp": "0.35.5"
  }
}
